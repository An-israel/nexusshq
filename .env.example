# Copy this file to .env and fill in your project's values.
# Variables prefixed with VITE_ are exposed to client-side code; everything
# else is server-only.

# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase Project Settings > API.
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# Service role key — server-only, never exposed to the client. Required by
# server functions, cron endpoints (as the bearer token pg_cron sends), and
# the email queue processor.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── AI providers ────────────────────────────────────────────────────────────
# Used by /api/ai, weekly summary emails, burnout detection, and voice note
# transcription.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# ── Transactional email (Resend) ────────────────────────────────────────────
# Used by the notification-email, message-email, late-task-report, and
# weekly-summary-email cron jobs.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@yourdomain.com"
EMAIL_FROM="notifications@yourdomain.com"

# ── Supabase Auth email hook ────────────────────────────────────────────────
# Secret for the Supabase Auth "Send Email" hook (Dashboard -> Authentication
# -> Hooks -> Send Email), used by src/routes/api/public/auth-email-webhook.ts
# to verify incoming requests via the Standard Webhooks spec. Supabase shows
# this as a "v1,whsec_..." string when you configure the hook.
SUPABASE_AUTH_HOOK_SECRET=""

# ── Push notifications (Web Push / VAPID) ───────────────────────────────────
VITE_VAPID_PUBLIC_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@yourdomain.com"

# ── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=""

# ── WhatsApp notifications ──────────────────────────────────────────────────
WHATSAPP_API_KEY=""
WHATSAPP_USERNAME=""
WHATSAPP_SENDER_ID=""

# Client-side: phone number (with country code, no "+" or spaces, e.g.
# 2348012345678) used for the marketing site's "Chat on WhatsApp" link.
# When unset, that link falls back to the demo request mailto link.
VITE_WHATSAPP_NUMBER=""

# ── Calendar feed (ICS) ─────────────────────────────────────────────────────
# Secret used to sign per-user calendar feed tokens.
CALENDAR_SECRET=""

# ── App URL ──────────────────────────────────────────────────────────────────
# Base URL used to build links in emails (defaults to https://nexxoshq.app).
APP_URL="https://your-app-domain.com"

# ── Observability ───────────────────────────────────────────────────────────
VITE_SENTRY_DSN=""
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://app.posthog.com"
VITE_CRISP_WEBSITE_ID=""
